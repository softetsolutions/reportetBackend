# Copy to .env on the server and fill real values. Never commit .env.

NODE_ENV=production
PORT=5005

MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DB
JWT_SECRET=replace-with-long-random-secret

# Used for password-reset links in emails
FRONTEND_URL=https://www.softetsolutions.com

# Comma-separated extra CORS origins (defaults already include softetsolutions.com)
# CORS_ORIGINS=https://staging.example.com

# Brevo / Mapbox (if used)
BREVO_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Set true only if you need Swagger in production (default: disabled when NODE_ENV=production)
# ENABLE_SWAGGER=false
